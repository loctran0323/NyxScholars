# ─────────────────────────────────────────────────────────────────────────────
# Nyx Scholars — environment variables
# Copy this file to `.env.local` for local development. In production, set the
# same variables in Vercel → Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server-only. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — fill these in once you have a Stripe account.
# Test keys begin with sk_test_ / pk_test_. Live keys begin with sk_live_ / pk_live_.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs for each plan (create them in the Stripe dashboard).
# These map to the plans rendered on /portal/upgrade.
STRIPE_PRICE_SESSION=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_COUNSELING=

# Public site URL — used to build Stripe success/cancel callbacks.
# Locally: http://localhost:3000  ·  In Vercel, set to your deployed origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin portal password (used by /admin/login)
ADMIN_PASSWORD=
